# ─────────────────────────────────────────────────────────────────────────────
# ai-stack settings shared by every deployment profile.
# scripts/bootstrap.sh --profile <vps|poc-wsl> copies this to .env, appends
# profiles/<profile>/stack.env (budget, bind address, compose overrides) and
# fills every secret marked "generated". Edit .env afterwards, not this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────────────────────
LITELLM_PORT=4000
HERMES_API_PORT=8642

# ── Images (pin to digests once you have a working set) ──────────────────────
POSTGRES_IMAGE=pgvector/pgvector:pg17
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMACPP_GPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:latest
HERMES_IMAGE=nousresearch/hermes-agent:stable

# Optional: Hugging Face token (only needed for gated models)
HF_TOKEN=

# ── Model routes (LiteLLM) ───────────────────────────────────────────────────
# Defaults (empty) = the local llm-coder server. Set them when the local model
# is off (CPU file, LOCAL_MODEL=false) or `coder` should run elsewhere.
# MODEL uses LiteLLM's provider/model syntax. Examples:
#   remote llama.cpp (e.g. the PoC GPU over Tailscale):
#     CODER_MODEL=openai/coder   CODER_API_BASE=http://100.a.b.c:8080/v1
#   hosted open-weight provider (OpenAI-compatible):
#     CODER_MODEL=openai/qwen/qwen3-coder   CODER_API_BASE=https://<provider>/v1
CODER_MODEL=
CODER_API_BASE=
CODER_API_KEY=
# Autocomplete needs an endpoint with raw /v1/completions (FIM). Leave empty to
# reuse the CODER_* endpoint, or turn autocomplete off in the editor.
AUTOCOMPLETE_MODEL=
AUTOCOMPLETE_API_BASE=
AUTOCOMPLETE_API_KEY=
# Hindsight's extraction model. Remote = memory content leaves this machine.
MEMORY_MODEL=
MEMORY_API_BASE=
MEMORY_API_KEY=
# GPU host only: interface that publishes llm-coder for a VPS (Tailscale IP)
CODER_BIND=127.0.0.1

# ── Postgres ─────────────────────────────────────────────────────────────────
# generated
POSTGRES_PASSWORD=
# generated
LITELLM_DB_PASSWORD=
# generated
HINDSIGHT_DB_PASSWORD=

# ── LiteLLM ──────────────────────────────────────────────────────────────────
# generated (sk-...). Admin key: keep it off client machines.
LITELLM_MASTER_KEY=
# generated. Encrypts provider keys in the DB. NEVER change after first run.
LITELLM_SALT_KEY=
LITELLM_UI_USERNAME=admin
# generated
LITELLM_UI_PASSWORD=

# Virtual keys, created by bootstrap.sh through LiteLLM's /key/generate API.
# used by Hermes -> LiteLLM
HERMES_LLM_API_KEY=
# used by Hindsight -> LiteLLM
HINDSIGHT_LLM_API_KEY=
# give this one to VS Code / Continue
VSCODE_LLM_API_KEY=

# Optional cloud fallbacks (leave empty to stay 100% local)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Hermes ───────────────────────────────────────────────────────────────────
# generated. Bearer token for Hermes' OpenAI-compatible API.
HERMES_API_KEY=
# set by bootstrap.sh to the user running it
HERMES_UID=1000
HERMES_GID=1000
# Your code lives here. It is mounted into Hermes at the SAME absolute path,
# so the file paths Hermes reports match what VS Code shows.
WORKSPACE_DIR=/home/CHANGE_ME/code

# ── Profile (appended by bootstrap.sh from profiles/<profile>/stack.env) ─────
