# ─────────────────────────────────────────────────────────────────────────────
# ai-stack configuration. Copy to .env (scripts/bootstrap.sh does it for you
# and fills every secret marked "generated").
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────
# Address the LAN-facing services (LiteLLM, Hermes API) bind to.
# 0.0.0.0 = reachable from the LAN (after the Windows steps in docs/wsl-lan.md).
# 127.0.0.1 = this machine only.
LAN_BIND=0.0.0.0
LITELLM_PORT=4000
HERMES_API_PORT=8642
# Bind for Hermes' direct API. LiteLLM already proxies it as model `hermes-agent`,
# so 127.0.0.1 is the tighter choice if you don't need direct access.
HERMES_BIND=0.0.0.0

# ── Resource budget ──────────────────────────────────────────────────────────
# Everything except llm-coder shares a hard envelope. scripts/doctor.sh fails
# if the per-service limits below add up to more than this.
STACK_CPUS=4
STACK_MEM_MB=7168
PG_CPUS=0.5
PG_MEM=768m
LITELLM_CPUS=0.5
LITELLM_MEM=1024m
HINDSIGHT_CPUS=1.0
HINDSIGHT_MEM=2048m
HERMES_CPUS=1.5
HERMES_MEM=2560m
AUTOCOMPLETE_CPUS=0.5
AUTOCOMPLETE_MEM=768m
# llm-coder has no limit: it is the one service allowed to use more.

# ── Images (pin to a digest once you have a working set) ─────────────────────
POSTGRES_IMAGE=pgvector/pgvector:pg17
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:latest
HERMES_IMAGE=nousresearch/hermes-agent:stable

# ── Local models (llama.cpp pulls these from Hugging Face on first start) ────
# Main coding/agent model. Must support tool calling and >= 64k context
# (Hermes refuses smaller windows). See docs/models.md for other VRAM sizes.
CODER_MODEL=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M
CODER_CTX=65536
# Parallel request slots. Context is split across slots: 2 slots @ 131072 = 65536 each.
CODER_PARALLEL=1
# KV-cache quantization (q8_0 roughly halves KV VRAM with negligible quality loss)
CODER_KV_TYPE=q8_0

# Small FIM (fill-in-the-middle) model for inline autocomplete.
AUTOCOMPLETE_MODEL=ggml-org/Qwen2.5-Coder-1.5B-Q8_0-GGUF
AUTOCOMPLETE_CTX=8192

# Optional: Hugging Face token (only needed for gated models)
HF_TOKEN=

# ── Postgres ─────────────────────────────────────────────────────────────────
# generated
POSTGRES_PASSWORD=
# generated
LITELLM_DB_PASSWORD=
# generated
HINDSIGHT_DB_PASSWORD=

# ── LiteLLM ──────────────────────────────────────────────────────────────────
# generated (sk-...). Admin key: keep it off client machines.
LITELLM_MASTER_KEY=
# generated. Encrypts provider keys in the DB. NEVER change after first run.
LITELLM_SALT_KEY=
LITELLM_UI_USERNAME=admin
# generated
LITELLM_UI_PASSWORD=

# Virtual keys, created by bootstrap.sh through LiteLLM's /key/generate API.
# used by Hermes -> LiteLLM
HERMES_LLM_API_KEY=
# used by Hindsight -> LiteLLM
HINDSIGHT_LLM_API_KEY=
# give this one to VS Code / Continue
VSCODE_LLM_API_KEY=

# Optional cloud fallbacks (leave empty to stay 100% local)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Hermes ───────────────────────────────────────────────────────────────────
# generated. Bearer token for Hermes' OpenAI-compatible API.
HERMES_API_KEY=
# set by bootstrap.sh to your WSL user
HERMES_UID=1000
HERMES_GID=1000
# Your code lives here. It is mounted into Hermes at the SAME absolute path, so
# file paths Hermes reports match what VS Code shows.
WORKSPACE_DIR=/home/CHANGE_ME/code
