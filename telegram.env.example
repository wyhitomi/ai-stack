# ─────────────────────────────────────────────────────────────────────────────
# Telegram gateway for Hermes (optional). Template only: NO real values here.
#
#   scripts/setup-telegram.sh     # writes ./telegram.env (git-ignored, mode 600)
#
# or copy this file to ./telegram.env and fill it in by hand. Compose loads
# telegram.env into the hermes container only when the file exists; without
# it, Telegram stays off. Hermes long-polls api.telegram.org (outbound only):
# no port is opened, nothing changes in the home-LAN firewall rules.
# Docs: docs/telegram.md
# ─────────────────────────────────────────────────────────────────────────────

# From @BotFather (/newbot). Format: 123456789:ABCdef...  Treat it as a password.
TELEGRAM_BOT_TOKEN=

# REQUIRED. Numeric Telegram user IDs allowed to talk to the bot, comma-separated
# (not @usernames). Whoever is listed here can make Hermes run shell commands
# on your workspace. Empty = Hermes denies everyone.
TELEGRAM_ALLOWED_USERS=

# Optional: chat where Hermes delivers scheduled (cron) results. Your user ID
# works for a DM; group IDs are negative (-100...).
TELEGRAM_HOME_CHANNEL=
