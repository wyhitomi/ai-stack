#!/usr/bin/env bash
# Enforce Conventional Commits (https://www.conventionalcommits.org) on the
# first line of every commit message. Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail

subject="$(head -n1 "$1")"

# Messages git writes itself are allowed as-is.
[[ "$subject" =~ ^(Merge|Revert\ \"|fixup!|squash!|amend!) ]] && exit 0

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
re="^(${types})(\([a-z0-9._/-]+\))?!?: [^ ].*$"

if [[ ! "$subject" =~ $re ]]; then
  cat >&2 <<MSG
✗ Commit message is not a Conventional Commit:
    $subject

  Format:  <type>(<optional scope>)<optional !>: <description>
  Types:   ${types//|/, }
  Example: feat(litellm): add cloud fallback route
           fix(bootstrap)!: refuse to run from /mnt/c

  See CONTRIBUTING.md.
MSG
  exit 1
fi

if (( ${#subject} > 72 )); then
  echo "✗ Subject line is ${#subject} characters; keep it ≤ 72." >&2
  exit 1
fi
