# Copy to %UserProfile%\.wslconfig, then run `wsl --shutdown` in PowerShell.
# Requires Windows 11 22H2+ and WSL 2.0+ (`wsl --version`).
[wsl2]
# Mirrored mode: WSL shares the Windows network interfaces, so a port bound
# to 0.0.0.0 in WSL is reachable at the laptop's LAN IP (firewall permitting:
# setup-lan.ps1 opens 4000/8642 to the home LAN subnet only).
networkingMode=mirrored
# Lets Windows apps reach WSL services on localhost (and vice-versa).
hostAddressLoopback=true
# Sized for the gpu profile on a 16 CPU / 32 GB laptop:
#   typical use ≈ 17 GB model (MoE experts in RAM) + ~3 GB stack + ~1.5 GB OS
#   container caps total 6.9 GB; swap absorbs the rare all-at-limit moment
# Leaves 8 GB RAM and 2 CPUs for Windows, VS Code and the browser.
memory=24GB
processors=14
swap=8GB

[experimental]
# Return freed memory to Windows gradually.
autoMemoryReclaim=gradual
sparseVhd=true
