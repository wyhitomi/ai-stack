# ─────────────────────────────────────────────────────────────────────────────
# Profile: poc-wsl — WSL2 on 16 CPU / 32 GB RAM / Blackwell GPU with 8 GB.
#
# Every service except the coding model gets EXACTLY the VPS limits, so the
# PoC proves the stack fits the VPS. The model is the one thing that differs:
# here it uses the GPU plus the spare RAM, so it can be a much larger model.
#
#   memory (MB)                 cpus cap
#   postgres          512        0.50   ┐
#   litellm           768        0.50   │ identical to the vps profile
#   hindsight        1536        0.75   │
#   hermes           1536        1.00   ┘
#   llm-autocomplete  512        0.50   (GPU, ~2 GB VRAM)
#   ───────────────────────
#   capped           4864 MB   ≤ 7168 MB envelope (4 CPU / 7 GB)
#   llm-coder        uncapped  (≈ 6 GB VRAM + ≈ 18 GB RAM for the MoE experts)
# ─────────────────────────────────────────────────────────────────────────────
STACK_PROFILE=poc-wsl
COMPOSE_FILE=docker-compose.yml:compose.gpu.yml
COMPOSE_PROFILES=autocomplete

STACK_CPUS=4
STACK_MEM_MB=7168
BUDGET_EXEMPT=llm-coder

PG_CPUS=0.5
PG_MEM=512m
LITELLM_CPUS=0.5
LITELLM_MEM=768m
HINDSIGHT_CPUS=0.75
HINDSIGHT_MEM=1536m
HERMES_CPUS=1.0
HERMES_MEM=1536m
AUTOCOMPLETE_CPUS=0.5
AUTOCOMPLETE_MEM=512m

CODER_API_BASE=http://llm-coder:8080/v1
AUTOCOMPLETE_API_BASE=http://llm-autocomplete:8080/v1
CODER_CTX=65536

LAN_BIND=0.0.0.0
HERMES_BIND=0.0.0.0
