# Small FIM model fully on the GPU (~2 GB VRAM). Starts BEFORE llm-coder, so
# llm-coder's --fit sizes itself around it.
LLAMA_ARG_HF_REPO=ggml-org/Qwen2.5-Coder-1.5B-Q8_0-GGUF
LLAMA_ARG_ALIAS=autocomplete
LLAMA_ARG_CTX_SIZE=8192
LLAMA_ARG_N_PARALLEL=1
LLAMA_ARG_N_GPU_LAYERS=all
LLAMA_ARG_FIT=off
LLAMA_ARG_THREADS=1
LLAMA_ARG_THREADS_HTTP=2
LLAMA_ARG_CACHE_RAM=0
