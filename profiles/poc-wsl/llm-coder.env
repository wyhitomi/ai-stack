# llama.cpp server for the PoC: 8 GB Blackwell + 32 GB RAM.
#
# Qwen3-Coder-30B-A3B-Instruct (Apache-2.0, MoE, ~3B active per token).
# Too big for 8 GB of VRAM (~18.6 GB at Q4_K_M), but it is a MoE: attention,
# KV cache and shared weights go on the GPU, and most expert weights stay in
# RAM. `--fit` (on by default) does that split automatically from the free
# VRAM, keeping LLAMA_ARG_FIT_TARGET MiB spare for Windows and autocomplete.
#   VRAM ≈ 6 GB (KV 64k @ q8_0 ≈ 3.2 GB) · RAM ≈ 17-18 GB · ~15-25 tok/s
LLAMA_ARG_HF_REPO=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M
LLAMA_ARG_ALIAS=coder,memory
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_N_PARALLEL=1
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_JINJA=true
LLAMA_ARG_FIT=on
LLAMA_ARG_FIT_TARGET=768
# Expert matmuls run on the CPU: memory bandwidth bound, physical cores matter
LLAMA_ARG_THREADS=8
LLAMA_ARG_THREADS_HTTP=4
# Bigger prompt batches = faster prefill of Hermes' long system prompt
LLAMA_ARG_UBATCH=1024
LLAMA_ARG_CACHE_RAM=4096
