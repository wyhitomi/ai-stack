# llama.cpp server for the VPS (CPU only, 3 GB cap). Every LLAMA_ARG_* maps to
# a llama-server flag: https://github.com/ggml-org/llama.cpp/tree/master/tools/server
#
# Qwen2.5-Coder-1.5B-Instruct (Apache-2.0): small enough for 3 GB with a 64k
# context, has FIM tokens (so it doubles as autocomplete) and basic tool calling.
#   weights Q6_K ≈ 1.3 GB · KV 64k @ q8_0 ≈ 1.0 GB · buffers + prompt cache ≈ 0.4 GB
LLAMA_ARG_HF_REPO=bartowski/Qwen2.5-Coder-1.5B-Instruct-GGUF:Q6_K
LLAMA_ARG_ALIAS=coder,autocomplete,memory
LLAMA_ARG_CTX_SIZE=65536
# Native window is 32k: stretch to 64k with YaRN (as the Qwen model card advises)
LLAMA_ARG_ROPE_SCALING_TYPE=yarn
LLAMA_ARG_ROPE_SCALE=2
LLAMA_ARG_YARN_ORIG_CTX=32768
LLAMA_ARG_N_PARALLEL=1
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_JINJA=true
LLAMA_ARG_N_GPU_LAYERS=0
LLAMA_ARG_THREADS=3
LLAMA_ARG_THREADS_HTTP=2
# Host-RAM prompt cache. llama.cpp's default (8 GB) would blow the 3 GB cap.
LLAMA_ARG_CACHE_RAM=128
