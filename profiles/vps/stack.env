# ─────────────────────────────────────────────────────────────────────────────
# Profile: vps — 4 vCPU / 8 GB RAM, no GPU. EVERYTHING (model included) fits.
#
#   memory budget (MB)          cpus cap
#   postgres          512        0.50
#   litellm           768        0.50
#   hindsight        1536        0.75
#   hermes           1536        1.00
#   llm-coder        3072        3.00   (chat + autocomplete + memory, one model)
#   ───────────────────────
#   containers       7424 MB   → 768 MB left for kernel, dockerd, sshd
#
# Memory is a hard, summed budget (it can't be shared). CPU caps are per
# service and intentionally overlap: CPU time is shared, idle cores aren't
# wasted, and no single service can take more than its cap.
# ─────────────────────────────────────────────────────────────────────────────
STACK_PROFILE=vps
COMPOSE_FILE=docker-compose.yml:compose.vps.yml
COMPOSE_PROFILES=

STACK_CPUS=4
STACK_MEM_MB=7424
# Services excluded from the memory sum (none on the VPS: the model counts too)
BUDGET_EXEMPT=

PG_CPUS=0.5
PG_MEM=512m
LITELLM_CPUS=0.5
LITELLM_MEM=768m
HINDSIGHT_CPUS=0.75
HINDSIGHT_MEM=1536m
HERMES_CPUS=1.0
HERMES_MEM=1536m
CODER_CPUS=3.0
CODER_MEM=3072m

# One small model serves every route on the VPS.
AUTOCOMPLETE_API_BASE=http://llm-coder:8080/v1
# To use a GPU host for the agent (recommended, see docs/deploy-vps.md):
# CODER_API_BASE=http://100.x.y.z:8080/v1
CODER_API_BASE=http://llm-coder:8080/v1

# Must match LLAMA_ARG_CTX_SIZE in llm-coder.env (Hermes needs >= 64k)
CODER_CTX=65536

# Never publish on the public interface. Bootstrap replaces this with the
# Tailscale IP when Tailscale is installed (docs/deploy-vps.md).
LAN_BIND=127.0.0.1
HERMES_BIND=127.0.0.1
