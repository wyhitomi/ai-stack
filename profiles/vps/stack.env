# ─────────────────────────────────────────────────────────────────────────────
# Profile: vps — 4 vCPU / 8 GB RAM, no GPU, NO local model.
#
# Every model call goes over Tailscale to the WSL PoC machine's GPU:
#   coder, memory → WSL llm-coder        (Qwen3-Coder-30B-A3B)   :8080
#   autocomplete  → WSL llm-autocomplete (Qwen2.5-Coder-1.5B)    :8081
# Set it up with: scripts/bootstrap.sh --profile vps --gpu-host <wsl-tailscale-ip>
# (on WSL first: scripts/bootstrap.sh --profile poc-wsl --serve-vps)
#
#   memory budget (MB)          cpus cap
#   postgres          512        0.50
#   litellm           768        0.50
#   hindsight        2048        1.00
#   hermes           3072        2.00   (agent builds/tests run in here)
#   ───────────────────────
#   containers       6400 MB   ≤ 7424 MB → ≥ 768 MB for kernel, dockerd, sshd
# ─────────────────────────────────────────────────────────────────────────────
STACK_PROFILE=vps
COMPOSE_FILE=docker-compose.cpu.yml
# No local model on the VPS (bootstrap refuses --local-model on for this profile)
LOCAL_MODEL=false
COMPOSE_PROFILES=

STACK_CPUS=4
STACK_MEM_MB=7424
BUDGET_EXEMPT=

PG_CPUS=0.5
PG_MEM=512m
LITELLM_CPUS=0.5
LITELLM_MEM=768m
HINDSIGHT_CPUS=1.0
HINDSIGHT_MEM=2048m
HERMES_CPUS=2.0
HERMES_MEM=3072m

# Model routes → the WSL GPU host. GPU_HOST is replaced by --gpu-host <ip>.
# CODER_API_KEY must equal CODER_API_KEY in the WSL machine's .env.
CODER_MODEL=openai/coder
CODER_API_BASE=http://GPU_HOST:8080/v1
AUTOCOMPLETE_MODEL=text-completion-openai/autocomplete
AUTOCOMPLETE_API_BASE=http://GPU_HOST:8081/v1
MEMORY_MODEL=openai/memory
MEMORY_API_BASE=http://GPU_HOST:8080/v1
CODER_CTX=65536

# Never publish on the public interface. Bootstrap replaces this with the
# Tailscale IP when Tailscale is installed (docs/deploy-vps.md).
LAN_BIND=127.0.0.1
HERMES_BIND=127.0.0.1
