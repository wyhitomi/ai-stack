# ─────────────────────────────────────────────────────────────────────────────
# Profile: cpu — the same WSL2 laptop, GPU unused · docker-compose.cpu.yml
# Use it to compare CPU vs GPU, when the GPU is busy, or on battery.
#
#   memory (MB)                 cpus cap
#   postgres          512        0.50
#   litellm           768        0.50
#   hindsight        2048        1.00
#   hermes           3072        2.00
#   ───────────────────────
#   capped           6400 MB   ≤ 7168 MB envelope (4 CPU / 7 GB)
#   llm-coder       19456 MB    10.00   (Qwen3-Coder-30B-A3B Q3_K_M, in RAM;
#                                        serves coder + autocomplete + memory)
#
# The local model is optional here: bootstrap.sh --local-model off routes
# every model call to an external OpenAI-compatible endpoint (.env CODER_*).
# ─────────────────────────────────────────────────────────────────────────────
STACK_PROFILE=cpu
COMPOSE_FILE=docker-compose.cpu.yml
# Local model on/off. Change with: bootstrap.sh --local-model on|off
LOCAL_MODEL=true
COMPOSE_PROFILES=local-model

STACK_CPUS=4
STACK_MEM_MB=7168
BUDGET_EXEMPT=llm-coder

PG_CPUS=0.5
PG_MEM=512m
LITELLM_CPUS=0.5
LITELLM_MEM=768m
HINDSIGHT_CPUS=1.0
HINDSIGHT_MEM=2048m
HERMES_CPUS=2.0
HERMES_MEM=3072m
# Capped so a runaway prompt cache can't take WSL down, but far above the stack
CODER_CPUS=10.0
CODER_MEM=19g

CODER_API_BASE=http://llm-coder:8080/v1
AUTOCOMPLETE_API_BASE=http://llm-coder:8080/v1
MEMORY_API_BASE=http://llm-coder:8080/v1
CODER_CTX=65536

LAN_BIND=0.0.0.0
HERMES_BIND=0.0.0.0
