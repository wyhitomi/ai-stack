# Qwen3-Coder-30B-A3B on CPU only. A MoE model with ~3B active params per
# token, so it runs at a usable speed on CPU (~8-15 tok/s on 10 threads, slow
# prefill). Q3_K_M (~14.7 GB) instead of Q4_K_M so weights + 64k KV cache fit
# the 19 GB cap. One server answers coder, autocomplete and memory.
#   weights ≈ 14.7 GB · KV 64k @ q8_0 ≈ 3.2 GB · buffers + prompt cache ≈ 0.8 GB
LLAMA_ARG_HF_REPO=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q3_K_M
LLAMA_ARG_ALIAS=coder,autocomplete,memory
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_N_PARALLEL=1
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_JINJA=true
LLAMA_ARG_N_GPU_LAYERS=0
LLAMA_ARG_THREADS=10
LLAMA_ARG_THREADS_HTTP=2
LLAMA_ARG_CACHE_RAM=512
