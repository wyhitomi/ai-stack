# Qwen3-Coder-30B-A3B on CPU only: the SAME file as the gpu profile (one
# download, shared in data/models). MoE with ~3B active params per token, so it
# runs at a usable speed on CPU (~8-15 tok/s on 10 threads, slow prefill).
# One server answers coder, autocomplete (FIM) and memory.
#   weights 18.56 GB · KV 64k (K q8_0 + V q4_0) ≈ 2.6 GB · buffers + cache ≈ 0.6 GB
#   → cap CODER_MEM=22g; needs a WSL VM of ~27 GB (windows/wslconfig.example)
#
# SOURCE: Docker Hub (ai/ namespace), because huggingface.co is blocked.
LLAMA_ARG_DOCKER_REPO=ai/qwen3-coder:30b-a3b-q4_K_M
# Alternative where Hugging Face is reachable:
# LLAMA_ARG_HF_REPO=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M
LLAMA_ARG_ALIAS=coder,autocomplete,memory
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_N_PARALLEL=2
LLAMA_ARG_KV_UNIFIED=true
LLAMA_ARG_CACHE_TYPE_K=q8_0
# q4_0 V-cache saves ~0.8 GB of RAM (needs flash attention, enabled automatically)
LLAMA_ARG_CACHE_TYPE_V=q4_0
LLAMA_ARG_JINJA=true
LLAMA_ARG_N_GPU_LAYERS=0
LLAMA_ARG_THREADS=10
LLAMA_ARG_THREADS_HTTP=2
LLAMA_ARG_CACHE_RAM=256
