# ─────────────────────────────────────────────────────────────────────────────
# Profile: gpu (default) — WSL2 laptop · 16 CPU / 32 GB RAM / Blackwell 8 GB
# Compose file: docker-compose.gpu.yml
#
#   memory (MB)                 cpus cap
#   postgres          512        0.50
#   litellm           768        0.50
#   hindsight        2048        1.00
#   hermes           3072        2.00   (agent builds/tests run in here)
#   llm-autocomplete  512        0.50   (weights on the GPU, ~2 GB VRAM)
#   ───────────────────────
#   capped           6912 MB   ≤ 7168 MB envelope (4 CPU / 7 GB)
#   llm-coder        uncapped  the one service allowed to use more:
#                              ≈ 6 GB VRAM + ≈ 17 GB RAM (MoE experts)
#
# Reachable only from the home LAN: windows/setup-lan.ps1 limits ports 4000
# and 8642 to the local subnet. The model servers publish no ports at all.
# ─────────────────────────────────────────────────────────────────────────────
STACK_PROFILE=gpu
COMPOSE_FILE=docker-compose.gpu.yml
# The GPU file always runs its local models.
LOCAL_MODEL=true
COMPOSE_PROFILES=

STACK_CPUS=4
STACK_MEM_MB=7168
BUDGET_EXEMPT=llm-coder

PG_CPUS=0.5
PG_MEM=512m
LITELLM_CPUS=0.5
LITELLM_MEM=768m
HINDSIGHT_CPUS=1.0
HINDSIGHT_MEM=2048m
HERMES_CPUS=2.0
HERMES_MEM=3072m
AUTOCOMPLETE_CPUS=0.5
AUTOCOMPLETE_MEM=512m

CODER_API_BASE=http://llm-coder:8080/v1
AUTOCOMPLETE_API_BASE=http://llm-autocomplete:8080/v1
MEMORY_API_BASE=http://llm-coder:8080/v1
CODER_CTX=65536

# 0.0.0.0 inside WSL; the Windows firewall decides who gets in (LAN only).
LAN_BIND=0.0.0.0
HERMES_BIND=0.0.0.0
