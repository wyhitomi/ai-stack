# llama.cpp server for the gpu profile: Blackwell 8 GB laptop GPU + 32 GB RAM.
# One model serves every route: coder (chat/agent), autocomplete (FIM) and memory.
#
# Qwen3-Coder-30B-A3B-Instruct (Apache-2.0, MoE, ~3B active per token; Qwen:
# "FIM is supported in every version of Qwen3-Coder"). Too big for 8 GB of
# VRAM (18.56 GB at Q4_K_M), but it is a MoE: attention, KV cache and shared
# weights go on the GPU, most expert weights stay in RAM. `--fit` (on by
# default) does that split from the free VRAM, keeping FIT_TARGET MiB spare.
#   VRAM ≈ 6-7 GB · RAM ≈ 15-17 GB · ~15-25 tok/s
#
# SOURCE: Docker Hub (ai/ namespace), because huggingface.co is blocked on the
# corporate network. Tag list: https://hub.docker.com/r/ai/qwen3-coder/tags
# scripts/bootstrap.sh downloads MODEL_DOCKER_REPO's .gguf to LLAMA_ARG_MODEL
# (data/models is /root/.cache) before starting the server. llama.cpp's own
# LLAMA_ARG_DOCKER_REPO can't read Docker Hub's current ai/ model format.
MODEL_DOCKER_REPO=ai/qwen3-coder:30b-a3b-q4_K_M
LLAMA_ARG_MODEL=/root/.cache/gguf/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf
# Alternative where Hugging Face is reachable (comment out the two lines above):
# LLAMA_ARG_HF_REPO=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M
LLAMA_ARG_ALIAS=coder,autocomplete,memory
LLAMA_ARG_CTX_SIZE=65536
# Two slots sharing ONE 64k KV pool (unified): autocomplete requests don't wait
# behind a long Hermes turn, and Hermes can still use the full 64k window.
LLAMA_ARG_N_PARALLEL=2
LLAMA_ARG_KV_UNIFIED=true
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_JINJA=true
LLAMA_ARG_FIT=on
LLAMA_ARG_FIT_TARGET=768
# Expert matmuls run on the CPU: memory bandwidth bound, physical cores matter
LLAMA_ARG_THREADS=8
LLAMA_ARG_THREADS_HTTP=4
# Bigger prompt batches = faster prefill of Hermes' long system prompt
LLAMA_ARG_UBATCH=1024
LLAMA_ARG_CACHE_RAM=4096
