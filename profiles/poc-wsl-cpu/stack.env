# ─────────────────────────────────────────────────────────────────────────────
# Profile: poc-wsl-cpu — the WSL PoC box (16 CPU / 32 GB) WITHOUT its GPU.
# Same stack limits as vps/poc-wsl; the model runs on CPU from RAM.
# Use it to compare CPU vs GPU on the same machine, or when the GPU is busy.
#
#   memory (MB)                 cpus cap
#   postgres          512        0.50   ┐
#   litellm           768        0.50   │ identical to the vps profile
#   hindsight        1536        0.75   │
#   hermes           1536        1.00   ┘
#   ───────────────────────
#   capped           4352 MB   ≤ 7168 MB envelope
#   llm-coder       19456 MB    10.00   (Qwen3-Coder-30B-A3B Q3_K_M in RAM)
#
# WSL VM (windows/wslconfig.example, 26 GB): 4.3 + 19 + ~1.5 OS ≈ 25 GB.
# ─────────────────────────────────────────────────────────────────────────────
STACK_PROFILE=poc-wsl-cpu
COMPOSE_FILE=docker-compose.cpu.yml
# Local model on/off (CPU file only). Change with: bootstrap.sh --local-model on|off
# off → set CODER_/AUTOCOMPLETE_/MEMORY_ MODEL, API_BASE, API_KEY in .env
LOCAL_MODEL=true
COMPOSE_PROFILES=local-model

STACK_CPUS=4
STACK_MEM_MB=7168
BUDGET_EXEMPT=llm-coder

PG_CPUS=0.5
PG_MEM=512m
LITELLM_CPUS=0.5
LITELLM_MEM=768m
HINDSIGHT_CPUS=0.75
HINDSIGHT_MEM=1536m
HERMES_CPUS=1.0
HERMES_MEM=1536m
# Capped so a runaway prompt cache can't take WSL down, but far above the stack
CODER_CPUS=10.0
CODER_MEM=19g

CODER_API_BASE=http://llm-coder:8080/v1
AUTOCOMPLETE_API_BASE=http://llm-coder:8080/v1
CODER_CTX=65536

LAN_BIND=0.0.0.0
HERMES_BIND=0.0.0.0
